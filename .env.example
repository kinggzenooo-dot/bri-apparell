# =============================================================================
-- BRI APPARELL - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and configure values before starting the application.
# =============================================================================

# Flask Application Secret Key for session signing and cryptographic cookies
SECRET_KEY=replace-with-a-random-secure-secret-key-in-production

# Server Port (Render sets this dynamically)
PORT=5000

# Database Connection (PostgreSQL on Render / Supabase / Neon)
# If left commented or unset, the system gracefully falls back to local SQLite (bri_apparel.db)
# Example Render PostgreSQL connection:
# DATABASE_URL=postgresql://username:password@dpg-xxxx-a.singapore-postgres.render.com/bri_apparel_db
DATABASE_URL=

# Supabase (Optional CDN & Auth integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Mode
FLASK_ENV=production
DEBUG=False
